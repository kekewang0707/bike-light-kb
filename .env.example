# 自行车灯知识库 - 环境变量
BKL_DB_HOST=localhost
# 与 docker-compose.yml 的端口映射（5433:5432）保持一致
BKL_DB_PORT=5433
BKL_DB_NAME=bikelight_kb
BKL_DB_USER=bikelight
BKL_DB_PASSWORD=change_me_please_set

BKL_CHROMA_HOST=localhost
BKL_CHROMA_PORT=8000

# 替换为你自己的 DeepSeek API Key（请勿提交真实密钥）
BKL_DEEPSEEK_API_KEY=your-deepseek-api-key-here

BKL_DASHSCOPE_API_KEY=

BKL_CRAWLER_HEADLESS=false
BKL_CRAWLER_MAX_PRODUCTS=200

# ---- 合规 / 隐私 ----
# 用户昵称哈希的 pepper（务必改为随机长字符串；一旦启用不可随意更改，否则历史哈希失效）
BKL_PII_PEPPER=change_me_random_pepper
# 评价 PII 保留期(天)，超期后由 scripts/anonymize_pii.py 匿名化昵称哈希；0 表示不自动清理
BKL_DATA_RETENTION_DAYS=365
# 抓取速率(请求/分钟)与是否遵从 robots.txt
BKL_CRAWLER_RATE_PER_MINUTE=20
BKL_CRAWLER_RESPECT_ROBOTS=true
