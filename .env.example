# 自行车灯知识库 - 环境变量
BKL_DB_HOST=localhost
# 与 docker-compose.yml 的端口映射（5433:5432）保持一致
BKL_DB_PORT=5433
BKL_DB_NAME=bikelight_kb
BKL_DB_USER=bikelight
BKL_DB_PASSWORD=bikelight123

BKL_CHROMA_HOST=localhost
BKL_CHROMA_PORT=8000

# 替换为你自己的 DeepSeek API Key（请勿提交真实密钥）
BKL_DEEPSEEK_API_KEY=your-deepseek-api-key-here

BKL_DASHSCOPE_API_KEY=

BKL_CRAWLER_HEADLESS=false
BKL_CRAWLER_MAX_PRODUCTS=200
